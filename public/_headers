# Cloudflare Pages response headers. Mirrors vercel.json / netlify.toml
# so security posture is identical across hosts.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https://phantom.app https://solflare.com https://backpack.app https://us.i.posthog.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' https://us-assets.i.posthog.com; script-src-elem 'self' https://us-assets.i.posthog.com; connect-src 'self' http://localhost:8787 https://api.predictflow.org https://*.workers.dev https://*.dflow.net wss://*.dflow.net wss://api.prod.dflow.net https://*.solana.com https://*.helius-rpc.com https://*.quiknode.pro https://*.triton.one https://us.i.posthog.com https://us-assets.i.posthog.com; manifest-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
